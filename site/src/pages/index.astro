---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const cases = (await getCollection('cases')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="DesignStudio — работы">
  <section class="hero">
    <h1>{SITE.heroTitle}</h1>
    <!-- ЗАГЛУШКА из SITE.heroText; принцип show-don't-tell (design-principles.md п.1) -->
    <p>{SITE.heroText}</p>
  </section>

  <section aria-label="Портфолио">
    <div class="work-grid">
      {cases.map((c) => (
        <a class="work-card" href={`/cases/${c.id}/`}>
          <figure style="margin:0">
            <div class="thumb">
              {c.data.cover ? <img src={c.data.cover} alt={c.data.title} loading="lazy" decoding="async" /> : <div class="ph">плейсхолдер</div>}
            </div>
            <figcaption>
              {c.data.title} <span>— {c.data.category}{c.data.year ? `, ${c.data.year}` : ''}</span>
            </figcaption>
          </figure>
        </a>
      ))}
    </div>
  </section>
</Base>
