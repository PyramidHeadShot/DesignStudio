---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const cases = (await getCollection('cases')).sort(
  (a, b) => a.data.order - b.data.order,
);
// Категории (дисциплины) в порядке первых вхождений — для строки фильтров
const categories = [...new Set(cases.map((c) => c.data.category))];
// Волна S: слова hero — маски прямо в HTML (раньше splitWords перестраивал DOM
// на ~170мс → layout-shift сетки). Маски в серверной разметке = DOM стабилен.
const heroSpans = SITE.heroTitle
  .split(' ')
  .map((w) => `<span class="w" aria-hidden="true"><span class="wi">${w}</span></span>`)
  .join(' ');
// Волна P: счётчик работ у фильтра (демо №17) — статичный текст в HTML и
// клиентский пересчёт: правильное склонение по-русски (1 работа / 2 работы / 5 работ)
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
// Волна K: marquee-тикер подзаголовка героя (демо №20). Количество повторов
// фразы в ОДНОЙ половине трека: половина ≥ ширины вьюпорта → бесшовный -50% loop
// даже на широких экранах (~4300px на повтор).
const TICKER_REPS = 10;
// Волна L: линейные SVG-пиктограммы фильтров (демо №13). Единый язык: сетка 18×18,
// stroke 1.5, round, currentColor, без заливок; pathLength=100 — как у uline (draw).
const ICONS: Record<string, string> = {
  all: '<rect x="2.5" y="2.5" width="5" height="5" pathLength="100"/><rect x="10.5" y="2.5" width="5" height="5" pathLength="100"/><rect x="2.5" y="10.5" width="5" height="5" pathLength="100"/><rect x="10.5" y="10.5" width="5" height="5" pathLength="100"/>',
  'Реклама для ресторанов': '<path d="M5.5 2.5v3.5a1.75 1.75 0 0 0 3.5 0V2.5M7.25 2.5v13" pathLength="100"/><path d="M13.5 2.5v13M13.5 2.5c-2 2-2.4 4.4-1.4 6.4h1.4" pathLength="100"/>',
  'Дизайн упаковки': '<path d="M9 2.5 15 5.75 9 9 3 5.75Z" pathLength="100"/><path d="M3 5.75v6L9 15l6-3.25v-6" pathLength="100"/>',
  'Наружная реклама': '<rect x="2.5" y="3" width="13" height="7" rx="1" pathLength="100"/><path d="M6 10v5.5M12 10v5.5M6.5 6.5h5" pathLength="100"/>',
  'Полиграфия': '<path d="M9 4.5C7.5 3 5 2.5 2.5 2.5v11c2.5 0 5 .5 6.5 2 1.5-1.5 4-2 6.5-2v-11c-2.5 0-5 .5-6.5 2z" pathLength="100"/><path d="M9 4.5v11" pathLength="100"/>',
  'Инфографика и маркетплейсы': '<path d="M3.5 15.5V10M6.5 15.5V7.5" pathLength="100"/><rect x="8.5" y="2.5" width="7" height="5.5" rx="1" pathLength="100"/><path d="M10 15.5v-4" pathLength="100"/>',
  'Рекламные макеты': '<rect x="2.5" y="2.5" width="13" height="13" rx="1" pathLength="100"/><rect x="5.5" y="6" width="7" height="6" pathLength="100"/>',
};
---

<Base title={`${SITE.name} — работы`}>
  <section class="hero">
    <!-- Волна S: микро-деталь брутализма — одна маркировка (моно, ink-muted) -->
    <h1 aria-label={SITE.heroTitle}><Fragment set:html={heroSpans} /></h1>
    <!-- Волна K: подзаголовок — бесшовный marquee-тикер (демо №20). Читаемый
         экземпляр один (.ticker-static, скрыт визуально, читается скринридером;
         при prefers-reduced-motion становится видимой статичной фразой), весь
         визуальный трек aria-hidden. Разделитель — акцентная точка · -->
    <p class="ticker">
      <span class="ticker-static">{SITE.heroText}</span>
      <span class="ticker-viewport" aria-hidden="true">
        <span class="ticker-track">
          {[0, 1].map((h) => (<span class="ticker-g">{Array.from({ length: TICKER_REPS }).map(() => <span class="ticker-u">{SITE.heroText}</span>)}</span>))}
        </span>
      </span>
    </p>
    <!-- Волна S: draw-разделитель hero/сетка (демо №12; сдержанный --color-line) -->
    <svg class="hero-rule" viewBox="0 0 1200 2" preserveAspectRatio="none" aria-hidden="true">
      <line x1="0" y1="1" x2="1200" y2="1" pathLength="100" />
    </svg>
  </section>

  <section aria-label="Портфолио">
    {/* Фильтр — island; без JS скрыт (см. CSS), сетка показана полностью */}
    <div class="work-filters" role="group" aria-label="Фильтр работ по дисциплинам">
      <button type="button" class="work-filter" data-category="all" aria-pressed="true">
        <svg class="ficon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS.all} /></svg>Все
      </button>
      {categories.map((cat) => (
        <button type="button" class="work-filter" data-category={cat} aria-pressed="false">
          <svg class="ficon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={ICONS[cat] ?? ICONS.all} /></svg>{cat}
        </button>
      ))}
    </div>
    <div class="work-grid">
      {cases.map((c, i) => (
        <a class="work-card" href={`${base}/cases/${c.id}/`} data-category={c.data.category}>
          {/* Волна J: внутренняя tilt-обёртка — наклон пишет только она, внешняя
              карточка остаётся под управлением reveal/FLIP-трансформ (без конфликтов) */}
          <div class="tilt">
          <figure style="margin:0">
            <div class="thumb">
              {c.data.cover ? (
                <img
                  src={c.data.cover}
                  alt={`${c.data.title} — обложка кейса`}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i < 3 ? 'high' : 'auto'}
                  decoding="async"
                />
              ) : (
                <div class="ph" aria-hidden="true"></div>
              )}
            </div>
            <figcaption>
              {c.data.title} <span>— {c.data.category}</span>
            </figcaption>
          </figure>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    // Motion-слой главной (anime.js v4, .agents/skills/animejs/):
    // 1) кинетический hero — заголовок по словам (маска + translateY, stagger),
    //    затем подзаголовок, строка фильтров, сетка — одна timeline-хореография;
    // 2) FLIP-фильтр — First/Last/Invert/Play вручную (transform-only);
    // 3) карточки ниже вьюпорта — reveal по IntersectionObserver через animate().
    // Все эффекты замораживаются при prefers-reduced-motion (полный freeze).
    import { animate, createAnimatable, createTimeline, createScope, stagger, utils } from 'animejs';
    import { reduceMotion } from '../scripts/lib';

    // Волна N: вся инициализация — в boot(); модуль исполняется один раз.
    // Первый показ главной обслуживает верхний boot(), повторные приходы —
    // astro:page-load (маркер data-mboot на <main>; после свапа main новый).
    // Уход с главной: astro:before-swap сносит scope (твины не тикают в пустоту).
    document.documentElement.classList.add('js');

    let scope: ReturnType<typeof createScope> | null = null;

    function boot() {
    const cards = [...document.querySelectorAll<HTMLElement>('.work-card')];
    const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('.work-filter')];
    const filtersRow = document.querySelector<HTMLElement>('.work-filters');
    let io: IntersectionObserver | null = null;
    let filtering = false; // защита от спама кликами во время перехода

    createScope({
      mediaQueries: { reduce: '(prefers-reduced-motion: reduce)' },
    }).add((self) => {
      const frozen = () => self.matches.reduce || reduceMotion().matches;

      // --- Кинетический hero: единый ритм 400–600 мс, ease outQuint ---
      const h1 = document.querySelector<HTMLElement>('.hero h1');
      const sub = document.querySelector<HTMLElement>('.hero p');
      let words: HTMLElement[] = [];

      if (!frozen()) {
        // стартовые состояния — только из JS (без JS всё видно)
        // Волна S: слова уже в HTML-масках (без splitWords — DOM стабилен)
        if (h1) words = [...document.querySelectorAll<HTMLElement>('.hero h1 .wi')];
        const vh = window.innerHeight;
        const above = cards.filter((el) => el.getBoundingClientRect().top < vh);
        const below = cards.filter((el) => el.getBoundingClientRect().top >= vh);

        utils.set(words, { translateY: '115%' });
        if (sub) utils.set(sub, { opacity: 0, translateY: 16 });
        if (filtersRow) utils.set(filtersRow, { opacity: 0, translateY: 12 });
        utils.set(cards, { opacity: 0, translateY: 24 });

        const tl = createTimeline({ defaults: { ease: 'outQuint' } });
        if (words.length)
          tl.add(words, {
            translateY: ['115%', '0%'],
            duration: 520,
            delay: stagger(100),
          });
        if (sub)
          tl.add(sub, { opacity: [0, 1], translateY: [16, 0], duration: 480 }, '-=220');
        if (filtersRow)
          tl.add(
            filtersRow,
            {
              opacity: [0, 1],
              translateY: [12, 0],
              duration: 420,
              // Волна L: со стартом п��явления строки — класс-триггер прорисовки иконок (CSS-draw со stagger)
              // Волна P: там же — count-up 0 → N (единый ритм появления)
              onBegin: () => {
                filtersRow?.classList.add('icons-drawn');
                document.querySelector('.hero-rule')?.classList.add('is-drawn');
              },
            },
            '-=260',
          );
        if (above.length)
          tl.add(
            above,
            {
              opacity: [0, 1],
              translateY: [24, 0],
              duration: 520,
              delay: stagger(70),
            },
            '-=260',
          );

        // карточки ниже вьюпорта — reveal при попадании в видимость
        if (below.length) {
          if ('IntersectionObserver' in window) {
            io = new IntersectionObserver(
              (entries) => {
                for (const e of entries) {
                  if (!e.isIntersecting || frozen()) continue;
                  animate(e.target, {
                    opacity: [0, 1],
                    translateY: [24, 0],
                    duration: 520,
                    ease: 'outQuint',
                  });
                  io.unobserve(e.target);
                }
              },
              { threshold: 0.15 },
            );
            below.forEach((c) => io!.observe(c));
          } else {
            animate(below, {
              opacity: [0, 1],
              translateY: [24, 0],
              duration: 520,
              ease: 'outQuint',
              delay: stagger(60),
            });
          }
        }
      }

      // --- FLIP-фильтр: aria-pressed и скрытие — как раньше, перестройка — FLIP ---
      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (filtering) return;
          const cat = btn.dataset.category ?? 'all';
          // Волна J: при перестроении сетки наклон карточек сбрасывается к нулю
          // (tilt на внутренней обёртке, поэтому FLIP-трансформы не конфликтуют)
          cards.forEach((el) => {
            const t = (el as any).__tilt as { rotateX: (v: number) => void; rotateY: (v: number) => void; translateX: (v: number) => void; translateY: (v: number) => void } | undefined;
            t?.rotateX(0); t?.rotateY(0); t?.translateX(0); t?.translateY(0);
            const zone = el.querySelector<HTMLElement>('.tilt');
            if (zone) zone.style.willChange = '';
          });
          filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

          const first = new Map(cards.map((el) => [el, el.getBoundingClientRect()]));
          const leaving: HTMLElement[] = [];
          const entering: HTMLElement[] = [];
          const staying: HTMLElement[] = [];
          for (const el of cards) {
            const show = cat === 'all' || el.dataset.category === cat;
            if (!el.hidden && !show) leaving.push(el);
            if (el.hidden && show) entering.push(el);
            if (show) staying.push(el);
          }

          if (frozen()) {
            // мгновенно: только скрытие/показ (текущее поведение)
            cards.forEach((el) => {
              el.hidden = !staying.includes(el);
            });
            return;
          }
          filtering = true;

          const afterLeave = () => {
            filtering = false;
            leaving.forEach((el) => {
              el.hidden = true;
              el.style.opacity = '';
              el.style.transform = '';
            });
            entering.forEach((el) => {
              el.hidden = false;
              utils.set(el, { opacity: 0, translateY: 20, scale: 0.98 });
            });
            // FLIP остающихся: к новым позициям (transform-only, 450 мс outQuart)
            staying.forEach((el) => {
              const f = first.get(el);
              if (!f) return;
              const l = el.getBoundingClientRect();
              const dx = f.left - l.left;
              const dy = f.top - l.top;
              if (Math.abs(dx) > 1 || Math.abs(dy) > 1)
                animate(el, {
                  translateX: [dx, 0],
                  translateY: [dy, 0],
                  duration: 450,
                  ease: 'outQuart',
                });
            });
            // входящие: fade-up со stagger
            if (entering.length)
              animate(entering, {
                opacity: [0, 1],
                translateY: [20, 0],
                scale: [0.98, 1],
                duration: 420,
                ease: 'outQuart',
                delay: stagger(40),
              });
          };

          if (leaving.length) {
            // уходящие растворяются + scale .95 (stagger 40)
            animate(leaving, {
              opacity: [1, 0],
              scale: [1, 0.95],
              duration: 260,
              ease: 'inOut(2)',
              delay: stagger(40),
            }).then(afterLeave);
          } else {
            afterLeave();
          }
        });
      });

      // --- Волна J: hover-tilt карточек (демо №11, createAnimatable — chained-twins) ---
      // Наклон/смещение пишет только внутренняя .tilt-обёртка (transform-only);
      // зум обложки — прежний CSS-scale внутри .thumb. Только мышь с hover;
      // при prefers-reduced-motion тилт не навешивается; без JS — как раньше.
      // Rect кэшируется на pointerenter (без layout-чтений в move), will-change
      // ставится на входе и снимается на выходе.
      const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
      if (!frozen() && fineHover.matches) {
        cards.forEach((card) => {
          const zone = card.querySelector<HTMLElement>('.tilt');
          if (!zone) return;
          const rot = createAnimatable(zone, {
            rotateX: 400, rotateY: 400, translateX: 400, translateY: 400, // возврат/догон ~400 мс
            ease: 'out(3)',
          });
          (card as any).__tilt = rot; // используется для сброса в FLIP-фильтре
          let rect: DOMRect | null = null;
          card.addEventListener('pointerenter', () => {
            if (frozen()) return;
            rect = card.getBoundingClientRect();
            if (zone.style.willChange !== 'transform') zone.style.willChange = 'transform';
          }, { passive: true });
          card.addEventListener('pointermove', (e) => {
            if (frozen() || !rect) return;
            const x = (e.clientX - rect.left) / rect.width - 0.5;  // −0.5..0.5
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            rot.rotateY(x * 14);   // до ±7°
            rot.rotateX(-y * 12);  // до ±6°
            rot.translateX(x * 8); // до ±4px
            rot.translateY(y * 6);
          }, { passive: true });
          card.addEventListener('pointerleave', () => {
            rect = null;
            zone.style.willChange = '';
            rot.rotateX(0); rot.rotateY(0); rot.translateX(0); rot.translateY(0); // плавный возврат 400 мс
          });
        });
      }

      return () => io?.disconnect();
      });
    }

    boot();
    document.querySelector('main')?.setAttribute('data-mboot', '1');

    document.addEventListener('astro:page-load', () => {
      if (!document.querySelector('.work-grid')) {
        // мы не на главной — гасим твины предыдущего экземпляра
        scope?.revert();
        scope = null;
        return;
      }
      const main = document.querySelector('main');
      if (main?.hasAttribute('data-mboot')) return; // этот экземпляр уже поднят верхним boot()
      scope?.revert();
      boot();
      main?.setAttribute('data-mboot', '1');
    });

    document.addEventListener('astro:before-swap', () => {
      scope?.revert();
      scope = null;
    });
  </script>
</Base>
