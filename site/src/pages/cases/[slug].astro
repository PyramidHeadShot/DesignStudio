---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return cases.map((c, i) => ({ params: { slug: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// Сосед по order из отсортированной коллекции: следующий, циклично (6 кейсов → 1-й)
const cases = (await getCollection('cases')).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = cases.findIndex((c) => c.id === entry.id);
const next = cases[(idx + 1) % cases.length];
// BASE_URL с учётом base из astro.config.mjs (GitHub Pages /DesignStudio)
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base title={`${entry.data.title} — DesignStudio`}>
  <!-- Акцентная линия прогресса чтения сверху (scroll-linked scaleX, transform-only) -->
  <div class="read-progress" aria-hidden="true"></div>

  <article class="container case">
    <header class="case-head">
      <h1>{entry.data.title}</h1>
      <p style="color:var(--muted)">
        {entry.data.client ?? '?'} · {entry.data.category}{entry.data.year ? ` · ${entry.data.year}` : ''}
      </p>
    </header>
    {entry.data.cover && (
      <!-- Волна Q: обёртка параллакса — overflow hidden; fade-up перенесён с img на
           обёртку (иначе fill-mode обеих блокировал бы inline transform параллакса) -->
      <div class="case-hero-wrap">
        <Image
          class="case-hero"
          src={entry.data.cover}
          alt={`${entry.data.title} — обложка кейса`}
          widths={[800, 1200, 1600]}
          sizes="(min-width: 900px) 860px, 100vw"
          loading="eager"
          decoding="async"
        />
      </div>
    )}
    <div class="case-body">
      <Content />
    </div>

    <!-- Навигация между кейсами: назад на сетку / следующий кейс (циклично) -->
    <nav class="case-nav" aria-label="Навигация по кейсам">
      <a href={`${base}/`}>← все работы</a>
      <a href={`${base}/cases/${next.id}/`}>Следующий кейс: {next.data.title} →</a>
    </nav>
  </article>

  <script>
    // Страница кейса — минимум JS: прогресс-линия (rAF, transform scaleX)
    // и кинетический заголовок по словам (маска + CSS-transition со stagger-задержками).
    // Без библиотеки анимаций (budget), при prefers-reduced-motion — мгновенно.
    import { reduceMotion } from '../../scripts/lib';

    // Волна N: модуль исполняется один раз; scroll-слушатель — постоянный (bar
    // перечитывается на каждый boot), элементное — в boot() (верхний вызов +
    // astro:page-load c маркером data-sboot на <main>).
    document.documentElement.classList.add('js');

    let bar: HTMLElement | null = null;
    let parallaxHero: HTMLElement | null = null;
    let ticking = false;
    const updateProgress = () => {
      ticking = false;
      if (!bar) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
      bar.style.transform = `scaleX(${p})`;
    };
    // --- Волна Q: параллакс hero-фото (демо №18, subtle): ±6% высоты, rAF+passive.
    // Слушатель постоянный (модуль один раз), hero перечитывается в boot().
    const updateParallax = () => {
      if (!parallaxHero) return;
      const r = parallaxHero.getBoundingClientRect();
      const vh = window.innerHeight;
      if (r.bottom < 0 || r.top > vh) return; // вне экрана — не считаем
      const p = (vh - r.top) / (vh + r.height) - 0.5; // −0.5..0.5
      const y = Math.max(-1, Math.min(1, p * 2)) * parallaxHero.offsetHeight * 0.06;
      parallaxHero.style.transform = `translateY(${y.toFixed(1)}px) scale(1.08)`;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          updateProgress();
          updateParallax();
        });
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // --- Волна Q: «буквы-дождик» (демо №06) — посимвольные маски. Техника — CSS
    // transitions (паттерн logo-волны): anime.js ради 12-40 букв не тянем.
    // Только буквы/цифры маскируются, знаки препинания/кавычки — на местах.
    const splitChars = (el: HTMLElement) => {
      const text = el.textContent ?? '';
      el.setAttribute('aria-label', text.trim());
      el.textContent = '';
      const chars: HTMLElement[] = [];
      let i = 0;
      for (const ch of [...text]) {
        if (/[\p{L}\p{N}]/u.test(ch)) {
          const w = document.createElement('span');
          w.className = 'cw';
          w.setAttribute('aria-hidden', 'true');
          const c = document.createElement('span');
          c.className = 'ci';
          c.textContent = ch;
          c.style.transitionDelay = `${i * 30}ms`; // stagger 30 мс
          w.appendChild(c);
          el.appendChild(w);
          chars.push(c);
          i++;
        } else {
          el.appendChild(document.createTextNode(ch));
        }
      }
      return chars;
    };

    function boot() {
      bar = document.querySelector<HTMLElement>('.read-progress');
      updateProgress();

      // --- Волна Q: параллакс — только при JS и без reduce; без них статика ---
      const hero = document.querySelector<HTMLElement>('.case-hero');
      parallaxHero = hero && !reduceMotion().matches ? hero : null;
      if (parallaxHero) updateParallax();

      // --- Заголовок: «буквы-дождик» (при reduce — не разбиваем: DOM pristine) ---
      const h1 = document.querySelector<HTMLElement>('.case-head h1');
      if (h1 && !reduceMotion().matches) {
        splitChars(h1);
        requestAnimationFrame(() => {
          requestAnimationFrame(() => h1.classList.add('is-in'));
        });
      }
    }

    boot();
    document.querySelector('main')?.setAttribute('data-sboot', '1');

    document.addEventListener('astro:page-load', () => {
      if (!document.querySelector('.case-head')) {
        // не страница кейса — слушатель остаётся, но молчит (bar/hero = null)
        bar = null;
        parallaxHero = null;
        return;
      }
      const main = document.querySelector('main');
      if (main?.hasAttribute('data-sboot')) return;
      boot();
      main?.setAttribute('data-sboot', '1');
    });
  </script>
</Base>
