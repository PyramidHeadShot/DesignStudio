---
import '../styles/global.css';

interface Props { title?: string; }
const { title = 'DesignStudio' } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ru"> <!-- TODO: язык интерфейса не выбран (см. .ai/PROJECT.md) — уточнить -->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Дизайн-студия: портфолио и кейсы." />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">DesignStudio</a>
      <nav class="site-nav" aria-label="Основная навигация">
        <a href="/">Работы</a>
        <a href="/#contact">Контакты</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer" id="contact">
      <span>© {year} DesignStudio</span>
      <!-- TODO: реальные контакты — не придумывать -->
      <span>hello@?</span>
    </footer>
  </body>
</html>
