---
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import cyrFont from '../assets/fonts/inter-tight-cyrillic.woff2?url';
import { SITE } from '../config';

interface Props { title?: string; }
const { title = SITE.name } = Astro.props;
const year = new Date().getFullYear();
// BASE_URL с учётом base из astro.config.mjs (GitHub Pages /DesignStudio); нормализуем слэш
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
// tel: без пробелов
const phoneHref = SITE.phone.replace(/[^+\d]/g, '');
// Волна M: посимвольная разметка логотипа для flip-волны (демо №02): маски .lm
// с буквами .li; aria-label у контейнера, буквы aria-hidden (скринридер — один раз)
const LOGO = 'DesignStudio';
const logoSpans = [...LOGO]
  .map((ch) => `<span class="lm" aria-hidden="true"><span class="li">${ch}</span></span>`)
  .join('');
---

<!doctype html>
<html lang="ru">
  <head>
    <!-- Волна N: клиентские переходы (SPA) — тонкий fade на <main>, встроенный
         astro-fade сам отключается при prefers-reduced-motion -->
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={SITE.heroText} />
    <!-- preload основного subset'а (кириллица — язык сайта) -->
    <link rel="preload" as="font" type="font/woff2" href={cyrFont} crossorigin />
      <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
      <!-- Волна O: слот для page-специфичных meta (404: noindex) -->
      <slot name="head" />
</head>
  <body>
    <header class="site-header">
      <!-- Волна M: логотип — буквы в масках (без JS видны как обычный текст; a11y: aria-label) -->
      <a class="logo" href={`${base}/`} aria-label={LOGO}><Fragment set:html={logoSpans} /></a>
      <nav class="site-nav" aria-label="Основная навигация">
        <a href={`${base}/`}>Работы</a>
        <a href={`${base}/#contact`}>Контакты</a>
      </nav>
    </header>
    <main transition:animate={fade({ duration: '0.3s', easing: 'cubic-bezier(0.22, 1, 0.36, 1)' })}>
      <slot />
    </main>
    <footer class="site-footer" id="contact">
      <!-- Разделительная линия прорисовывается при появлении (SVG draw, stroke-dashoffset) -->
      <svg class="rule" aria-hidden="true" preserveAspectRatio="none">
        <line x1="0" y1="0.5" x2="100%" y2="0.5" pathLength="100" />
      </svg>
      <span>© {year} <span class="fw" aria-label={LOGO}><Fragment set:html={logoSpans} /></span></span>
      <span class="site-contacts">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={`tel:${phoneHref}`}>{SITE.phone}</a>
      </span> <!-- ЗАГЛУШКА -->
    </footer>
    <script>
      // Шапка: sticky-состояние после 30px скролла (фон/бордер через CSS-transition).
      // Скролл к якорям — плавный, с уважением prefers-reduced-motion.
      // Разделитель футера прорисовывается при входе в вьюпорт (IntersectionObserver).
      // underline-акценты (nav/подписи карточек) — SVG-линии со stroke-dashoffset:
      // чистый CSS-hover после одноразовой инъекции, без библиотеки на странице кейса.
      import { reduceMotion } from '../scripts/lib';

      // Волна N: модуль исполняется один раз (Astro дедуплицирует скрипты), поэтому
      // document/window-слушатели навешены здесь ОДИН раз и читают DOM заново на вызов.
      // Всё элементное (logo-in, uline, футер-IO) — в initBase() по astro:page-load
      // (событие файрит и на первой загрузке, и после каждого клиент-перехода).
      document.documentElement.classList.add('js');

      window.addEventListener(
        'scroll',
        () => {
          document
            .querySelector('.site-header')
            ?.classList.toggle('is-scrolled', window.scrollY > 30);
        },
        { passive: true },
      );

      // Плавные якоря — делегирование на document (переживает свапы DOM, без дублей)
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (!a) return;
        const url = new URL(a.href);
        if (!url.hash) return;
        if (url.pathname.replace(/\/+$/, '') !== window.location.pathname.replace(/\/+$/, '')) return;
        const target = document.getElementById(url.hash.slice(1));
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({
          behavior: reduceMotion().matches ? 'auto' : 'smooth',
        });
        history.replaceState(null, '', url.hash);
      });

      let footerIO: IntersectionObserver | null = null;

      function initBase() {
        // Волна M: триггер flip-волны логотипа шапки — первая нота до hero
        // (двойной rAF: transition стартует после первой отрисовки)
        const logo = document.querySelector('.logo');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => logo?.classList.add('logo-in'));
        });

        document
          .querySelector('.site-header')
          ?.classList.toggle('is-scrolled', window.scrollY > 30);

      // SVG-линия подчёркивания под ссылками nav и подписями карточек
      document.querySelectorAll('.site-nav a, .work-card figcaption').forEach((el) => {
        if (el.querySelector('.uline')) return;
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('class', 'uline');
        svg.setAttribute('aria-hidden', 'true');
        svg.setAttribute('preserveAspectRatio', 'none');
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', '0');
        line.setAttribute('y1', '0.75');
        line.setAttribute('x2', '100%');
        line.setAttribute('y2', '0.75');
        line.setAttribute('pathLength', '100');
        svg.appendChild(line);
        el.appendChild(svg);
      });

        // Футер: мягкий fade-up + прорисовка линии при входе в вьюпорт
        // (IO пересоздаётся на каждый page-load: старый гасим, DOM после свапа новый)
        footerIO?.disconnect();
        const footer = document.querySelector('.site-footer');
        if (footer && 'IntersectionObserver' in window) {
          footerIO = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-in');
                  footerIO?.disconnect();
                  footerIO = null;
                }
              }
            },
            { threshold: 0.25 },
          );
          footerIO.observe(footer);
        } else {
          footer?.classList.add('is-in');
        }
      }

      document.addEventListener('astro:page-load', initBase);
      initBase();
    </script>
  </body>
</html>
