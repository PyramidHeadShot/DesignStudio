{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ],
      "directTools": true
    },
    "ssh-connect": {
      "command": "bash",
      "args": [
        "scripts/ssh.sh"
      ],
      "directTools": true
    },
    "sftp-connect": {
      "command": "bash",
      "args": [
        "scripts/sftp.sh"
      ],
      "directTools": true
    }
  },
  "settings": {
    "mcpFooterStatus": "compact"
  }
}
